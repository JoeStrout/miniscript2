# Program to test various string functionality


@testConcat:
	# "abc" + "def" == "abcdef"
	LOAD r0, "String concatenation"
	LOAD r1, "abc"
	LOAD r2, "def"
	ADD r1, r1, r2
	LOAD r3, "abcdef"
	EQ r4, r1, r3
	BRTRUE r4, ok0
	RETURN
ok0:
	
	LOAD r0, 0  # all good!
	RETURN

@testConcatNumber:
	# "abc" + 1 == "abc1"
	LOAD r0, "String Concat Number (string + number)"
	LOAD r1, "abc"
	LOAD r2, 1
	ADD r1, r1, r2
	LOAD r3, "abc1"
	EQ r4, r1, r3
	BRTRUE r4, ok1
	RETURN
ok1:

	# 1 + "abc" == "1abc"
	LOAD r0, "String Concat Number (number + string)"
	LOAD r1, "abc"
	LOAD r2, 1
	ADD r1, r2, r1
	LOAD r3, "1abc"
	EQ r4, r1, r3
	BRTRUE r4, ok2
	RETURN
ok2:

	LOAD r0, 0  # all good!
	RETURN


@testMult:
	# "abc" * 2 == "abcabc"
	LOAD r0, "String * 2"
	LOAD r1, "abc"
	LOAD r2, 2
	MUL r1, r1, r2
	LOAD r3, "abcabc"
	EQ r4, r1, r3
	BRTRUE r4, ok3
	RETURN
ok3:
	
	# "abcdef" * 0.5 = "abc"
	LOAD r0, "String * 0.5"
	LOAD r1, "abcdef"
	LOAD r2, 0.5
	MUL r1, r1, r2
	LOAD r3, "abc"
	EQ r4, r1, r3
	BRTRUE r4, ok4
	RETURN
ok4:
	
	# All good!
	LOAD r0, 0
	RETURN

@testDiv:
	# "abcdef" / 2 = "abc"
	LOAD r0, "String / 2"
	LOAD r1, "abcdef"
	LOAD r2, 2
	DIV r1, r1, r2
	LOAD r3, "abc"
	EQ r4, r1, r3
	BRTRUE r4, ok5
	RETURN
ok5:
	
	# "abcdef" / 0.5 = "abcdefabcdef"
	LOAD r0, "String / 0.5"
	LOAD r1, "abcdef"
	LOAD r2, 0.5
	DIV r1, r1, r2
	LOAD r3, "abcdefabcdef"
	EQ r4, r1, r3
	BRTRUE r4, ok6
	RETURN
ok6:
	
	# All good!
	LOAD r0, 0
	RETURN

@main:
	CALLF 0, @testConcat
	BRTRUE r0, error
	CALLF 0, @testConcatNumber
	BRTRUE r0, error
	CALLF 0, @testMult
	BRTRUE r0, error
	CALLF 0, @testDiv
	BRTRUE r0, error
	LOAD r0, "✅ All tests passed!"
	RETURN

error:
	LOAD r1, "Test failure: "
	ADD r0, r1, r0
	RETURN
	
	